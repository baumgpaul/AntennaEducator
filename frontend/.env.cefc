# CEFC Environment (cefcantennaeducator.nyakyagyawa.com)
# ──────────────────────────────────────────────────────────────────
# This file is populated automatically by deploy_cefc_environment.ps1
# after running `terraform apply` in terraform/environments/cefc/.
# Do NOT commit filled-in secrets. The placeholder values below are
# updated by the deploy script before each frontend build.
# ──────────────────────────────────────────────────────────────────

# Lambda Function URLs for microservices  (filled in by deploy script)
VITE_API_BASE_URL=PLACEHOLDER_PROJECTS_URL
VITE_PROJECTS_URL=PLACEHOLDER_PROJECTS_URL
VITE_AUTH_URL=PLACEHOLDER_PROJECTS_URL
VITE_PREPROCESSOR_URL=PLACEHOLDER_PREPROCESSOR_URL
VITE_SOLVER_URL=PLACEHOLDER_SOLVER_URL
VITE_POSTPROCESSOR_URL=PLACEHOLDER_POSTPROCESSOR_URL

# Application settings
VITE_APP_NAME="Antenna Educator (CEFC 2026)"
VITE_APP_VERSION="0.1.0"

# Feature flags
VITE_ENABLE_AUTH=true
VITE_ENABLE_3D_DEBUG=false

# Authentication provider
VITE_AUTH_PROVIDER=cognito

# AWS Cognito Configuration  (filled in by deploy script)
VITE_COGNITO_USER_POOL_ID=PLACEHOLDER_USER_POOL_ID
VITE_COGNITO_CLIENT_ID=PLACEHOLDER_CLIENT_ID
VITE_COGNITO_DOMAIN=PLACEHOLDER_COGNITO_DOMAIN
VITE_COGNITO_REGION=eu-west-1
