# Production environment template (AWS deployment)
# Copy to .env.production (gitignored) for local production builds.
# CI (buildspec-deploy.yml) does not use a file: CodeBuild injects the same
# VITE_* variables from Terraform outputs (terraform/modules/cicd).
# ──────────────────────────────────────────────────────────────────
# NOTE: Lambda Function URLs and Cognito IDs are public client-side
# identifiers — they are NOT secrets. They must be embedded in the
# built JS bundle for the SPA to function.
# ──────────────────────────────────────────────────────────────────

# Lambda Function URLs for microservices
VITE_API_BASE_URL=https://<function-url-id>.lambda-url.<region>.on.aws
VITE_PROJECTS_URL=https://<function-url-id>.lambda-url.<region>.on.aws
VITE_AUTH_URL=https://<function-url-id>.lambda-url.<region>.on.aws
VITE_PREPROCESSOR_URL=https://<function-url-id>.lambda-url.<region>.on.aws
VITE_SOLVER_URL=https://<function-url-id>.lambda-url.<region>.on.aws
VITE_POSTPROCESSOR_URL=https://<function-url-id>.lambda-url.<region>.on.aws

# Application settings
VITE_APP_NAME="Antenna Educator"
VITE_APP_VERSION="0.1.0"

# Feature flags
VITE_ENABLE_AUTH=true
VITE_ENABLE_3D_DEBUG=false

# Authentication provider: 'cognito' for AWS Cognito
VITE_AUTH_PROVIDER=cognito

# AWS Cognito Configuration (public client-side identifiers)
VITE_COGNITO_USER_POOL_ID=<region>_<pool-id>
VITE_COGNITO_CLIENT_ID=<app-client-id>
VITE_COGNITO_DOMAIN=<cognito-domain-prefix>.auth.<region>.amazoncognito.com
VITE_COGNITO_REGION=eu-west-1
