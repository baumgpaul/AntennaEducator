# Production environment (AWS deployment)
# ──────────────────────────────────────────────────────────────────
# NOTE: Lambda Function URLs and Cognito IDs are public client-side
# identifiers — they are NOT secrets. They must be embedded in the
# built JS bundle for the SPA to function.
# ──────────────────────────────────────────────────────────────────

# Lambda Function URLs for microservices
VITE_API_BASE_URL=https://<FUNCTION_URL_ID>.lambda-url.eu-west-1.on.aws
VITE_PROJECTS_URL=https://<FUNCTION_URL_ID>.lambda-url.eu-west-1.on.aws
VITE_AUTH_URL=https://<FUNCTION_URL_ID>.lambda-url.eu-west-1.on.aws
VITE_PREPROCESSOR_URL=https://<FUNCTION_URL_ID>.lambda-url.eu-west-1.on.aws
VITE_SOLVER_URL=https://<FUNCTION_URL_ID>.lambda-url.eu-west-1.on.aws
VITE_POSTPROCESSOR_URL=https://<FUNCTION_URL_ID>.lambda-url.eu-west-1.on.aws
VITE_SOLVER_FDTD_URL=https://<FUNCTION_URL_ID>.lambda-url.eu-west-1.on.aws
# TODO: Set after deploying FDTD preprocessor and postprocessor Lambdas
VITE_FDTD_PREPROCESSOR_URL=
VITE_FDTD_POSTPROCESSOR_URL=

# Application settings
VITE_APP_NAME="Antenna Educator"
VITE_APP_VERSION="0.1.0"

# Feature flags
VITE_ENABLE_AUTH=true
VITE_ENABLE_3D_DEBUG=false

# Authentication provider: 'cognito' for AWS Cognito
VITE_AUTH_PROVIDER=cognito

# AWS Cognito Configuration (public client-side identifiers)
VITE_COGNITO_USER_POOL_ID=eu-west-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=<COGNITO_CLIENT_ID>
VITE_COGNITO_DOMAIN=antenna-simulator-staging-auth-<AWS_ACCOUNT_ID>.auth.eu-west-1.amazoncognito.com
VITE_COGNITO_REGION=eu-west-1
