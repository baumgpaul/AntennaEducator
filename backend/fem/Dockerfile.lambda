# FEM service (preview): FastAPI + Gmsh mesher + our solver, Lambda container.
FROM public.ecr.aws/lambda/python:3.11

# X/GL libraries the gmsh wheel links, even without a GUI (Amazon Linux 2)
RUN yum install -y -q mesa-libGLU libXcursor libXinerama libXft libXrender libXext libXfixes \
        fontconfig libgomp && yum clean all && rm -rf /var/cache/yum

COPY requirements-lambda.txt ${LAMBDA_TASK_ROOT}/
RUN pip install --no-cache-dir --only-binary=:all: -r ${LAMBDA_TASK_ROOT}/requirements-lambda.txt \
        "gmsh==4.15.2"

# Our FEM libraries (their dependencies are installed above)
COPY mesher/ /tmp/mesher/
COPY femsolver/ /tmp/femsolver/
RUN pip install --no-cache-dir --no-deps /tmp/mesher /tmp/femsolver && rm -rf /tmp/mesher /tmp/femsolver

# Fail the build, not the first request, if Gmsh cannot mesh in this image
RUN python -c "from fem_mesher import Geometry2D, mesh_geometry; \
m = mesh_geometry(Geometry2D.model_validate({'shapes': [{'kind': 'rectangle', 'name': 'a', 'x': 0, 'y': 0, 'width': 1, 'height': 1}], 'mesh': {'size': 0.5}})).mesh; \
assert m.n_triangles > 0; print('gmsh ok:', m.n_triangles, 'triangles')"

COPY backend/ ${LAMBDA_TASK_ROOT}/backend/
COPY backend/fem/lambda_handler.py ${LAMBDA_TASK_ROOT}/

CMD ["lambda_handler.handler"]
