# Lambda-optimized Dockerfile for Preprocessor Service
# Uses AWS Lambda Python 3.11 base image for container-based Lambda functions

FROM public.ecr.aws/lambda/python:3.11

# Runtime dependencies only. numpy/scipy ship manylinux wheels for Python 3.11,
# so no compilers are needed (they used to add several hundred MB per image).
COPY requirements-lambda.txt ${LAMBDA_TASK_ROOT}/
RUN pip install --no-cache-dir --only-binary=:all: -r ${LAMBDA_TASK_ROOT}/requirements-lambda.txt

# Copy the entire backend directory to maintain import structure
# This ensures 'from backend.preprocessor.main import app' works correctly
COPY backend/ ${LAMBDA_TASK_ROOT}/backend/
COPY backend/__init__.py ${LAMBDA_TASK_ROOT}/backend/__init__.py

# Copy the lambda handler
COPY backend/preprocessor/lambda_handler.py ${LAMBDA_TASK_ROOT}/

# Set the CMD to the Lambda handler
# Lambda will invoke: lambda_handler.handler(event, context)
CMD ["lambda_handler.handler"]
